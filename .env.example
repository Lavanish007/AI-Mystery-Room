# AI Mystery Room Environment Configuration Template
# Copy this file to .env and fill in your environment variables.
# NEVER commit your actual .env file or real secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Gemini AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Rate Limiting & Safety
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_CASE_GENERATION_PER_HOUR=10

# Media Generation (Optional - defaults to text-based if not configured)
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./uploads
